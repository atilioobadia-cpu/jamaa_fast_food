# Jamaa Fast Food prototype configuration
NODE_ENV=development
PORT=4100

# Session signing/secret material. Generate a long random value before deploying.
SESSION_SECRET=replace-this-with-a-long-random-string-before-deploying
SESSION_TTL_DAYS=7

# Demo payment flow (no real money, no gateway credentials required)
DEMO_MODE=true

# Delivery pricing (TZS)
DELIVERY_BASE_FEE=3000
DELIVERY_INCLUDED_KM=4
DELIVERY_PER_KM_FEE=600
DELIVERY_MAX_FEE=9000
DELIVERY_FREE_ABOVE=120000
DELIVERY_MAX_KM=25

# Storage
DATA_DIR=data
PUBLIC_DIR=public
